    "rules": [
      {
        "id": "farmer",
        "text": {
          "te": "మీరు వ్యవసాయం చేస్తారు",
          "en": "You farm"
        },
        "if": {
          "field": "occupation",
          "op": "in",
          "value": [
            "farmer_owner",
            "tenant_farmer",
            "agri_labourer"
          ]
        }
      },
      {
        "id": "pattadar",
        "text": {
          "te": "భూమి మీ పేరు మీద ఉంది (పట్టాదారు). కౌలు రైతులకు వర్తించదు.",
          "en": "Land is in your name (pattadar). Tenant farmers are not covered."
        },
        "if": {
          "field": "isPattadar",
          "op": "is_true"
        }
      }
    ],
    "alsoRequired": [
      {
        "te": "డబ్బులు రాకపోతే పాస్‌బుక్, బ్యాంకు వివరాలతో AEO/MAOని కలవండి",
        "en": "If you were missed, meet the AEO/MAO with your passbook and bank details"
      }
    ]
  },
