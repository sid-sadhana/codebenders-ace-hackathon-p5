      "te": "రైతు భరోసా",
      "en": "Rythu Bharosa"
    },
    "level": "state",
    "audience": [
      "farmer"
    ],
    "status": "automatic",
    "confidence": "high",
    "needsVerification": false,
    "benefit": {
      "te": "ఎకరానికి ఏడాదికి ₹12,000 (ఒక్కో సీజన్‌కు ₹6,000), నేరుగా బ్యాంకు ఖాతాకు",
      "en": "₹12,000 per acre a year (₹6,000 per season), paid straight to the bank account"
    },
    "benefitValue": 36000,
    "usualWindow": {
      "te": "యాసంగి విడత సుమారు డిసెంబర్ 2026లో రావచ్చు",
      "en": "Yasangi instalment expected around December 2026"
    },
    "officialSourceUrl": "https://rythubharosa.telangana.gov.in",
